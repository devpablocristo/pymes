PYMES_HTTP_ADDR=:8080
PYMES_API_PORT=18080
PYMES_WEB_PORT=15173
PYMES_DATABASE_URL=postgres://pymes_backend:pymes_backend@127.0.0.1:55433/pymes_v2?sslmode=disable
PYMES_MIGRATOR_DATABASE_URL=postgres://pymes_migrator:pymes_migrator@127.0.0.1:55433/pymes_v2?sslmode=disable
PYMES_SHUTDOWN_TIMEOUT=10s
PYMES_READINESS_TIMEOUT=2s
PYMES_ENVIRONMENT=development

# Clerk queda deshabilitado y fail-closed si estas variables están vacías.
# Obtener las claves de la aplicación exclusiva "Pymes v2"; nunca versionarlas.
PYMES_CLERK_PUBLISHABLE_KEY=
PYMES_CLERK_SECRET_KEY=
PYMES_CLERK_ISSUER=
PYMES_CLERK_AUDIENCE=pymes-v2-api
PYMES_CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:15173,http://localhost:15173
PYMES_CLERK_WEBHOOK_SECRET=
PYMES_CLERK_JWT_KEY=
PYMES_CLERK_API_URL=

# El worker IAM sólo se activa en Docker cuando PYMES_CLERK_SECRET_KEY existe.
PYMES_IAM_WORKER_BATCH_SIZE=1
PYMES_IAM_WORKER_POLL_INTERVAL=1s
PYMES_IAM_WORKER_LEASE_DURATION=2m
PYMES_IAM_WORKER_PUBLISH_TIMEOUT=90s
