#!/usr/bin/env bash
set -euo pipefail

: "${FAKE_RELEASE_SHA:?}"
: "${FAKE_ACCOUNTING_SHA:?}"

context=pymes
if [[ "${1:-}" == "-C" ]]; then
  context=accounting
  shift 2
fi

case "$*" in
  "rev-parse HEAD")
    if [[ "$context" == "accounting" ]]; then
      printf '%s\n' "$FAKE_ACCOUNTING_SHA"
    else
      printf '%s\n' "$FAKE_RELEASE_SHA"
    fi
    ;;
  "status --porcelain=v1 --untracked-files=all")
    ;;
  "remote get-url origin")
    if [[ "$context" == "accounting" ]]; then
      printf '%s\n' https://github.com/devpablocristo/open-accounting.git
    else
      printf '%s\n' https://github.com/devpablocristo/pymes.git
    fi
    ;;
  *)
    echo "fake git: unsupported command" >&2
    exit 97
    ;;
esac
