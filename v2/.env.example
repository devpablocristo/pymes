PYMES_HTTP_ADDR=:8080
PYMES_API_PORT=18080
PYMES_WEB_PORT=15173
PYMES_DATABASE_URL=postgres://pymes_backend:pymes_backend@127.0.0.1:55433/pymes_v2?sslmode=disable
PYMES_MIGRATOR_DATABASE_URL=postgres://pymes_migrator:pymes_migrator@127.0.0.1:55433/pymes_v2?sslmode=disable
PYMES_SHUTDOWN_TIMEOUT=10s
PYMES_READINESS_TIMEOUT=2s
PYMES_ENVIRONMENT=development

# El adaptador local cifrado es sólo para desarrollo/test.
PYMES_FISCAL_STORAGE_BACKEND=local
PYMES_FISCAL_STORAGE_DIR=tmp/fiscal
PYMES_FISCAL_MASTER_KEY=cHltZXMtdjItZGV2ZWxvcG1lbnQta2V5LTMyYnl0ZSE=

# Producción: PYMES_FISCAL_STORAGE_BACKEND=aws y estos valores son obligatorios.
# Las credenciales AWS NO se guardan aquí: usar identidad de workload/instancia
# o inyección de secretos del orquestador mediante la cadena estándar del SDK.
PYMES_FISCAL_AWS_REGION=
PYMES_FISCAL_KMS_KEY_ID=
PYMES_FISCAL_KMS_ENDPOINT=
PYMES_FISCAL_S3_BUCKET=
PYMES_FISCAL_S3_PREFIX=pymes-v2
PYMES_FISCAL_S3_ENDPOINT=
PYMES_FISCAL_S3_FORCE_PATH_STYLE=false

PYMES_FISCAL_WORKER_POLL_INTERVAL=2s
PYMES_FISCAL_WORKER_LEASE_DURATION=2m
# Sólo se pone en true durante una ejecución técnica explícita contra ARCA.
PYMES_FISCAL_HOMOLOGATION_ENABLED=false

# El posteo contable fiscal usa un rol tenant-scoped dedicado; no reutilizar
# el rol de la API ni el worker que posee certificados ARCA.
PYMES_FISCAL_ACCOUNTING_DATABASE_URL=postgres://pymes_fiscal_accounting_worker:pymes_fiscal_accounting_worker@127.0.0.1:55433/pymes_v2?sslmode=disable
PYMES_FISCAL_ACCOUNTING_WORKER_ID=
PYMES_FISCAL_ACCOUNTING_ACTOR=system:fiscal-accounting
PYMES_FISCAL_ACCOUNTING_POLL_INTERVAL=1s
PYMES_FISCAL_ACCOUNTING_RETRY_DELAY=30s
PYMES_FISCAL_ACCOUNTING_MAX_ATTEMPTS=10
PYMES_FISCAL_ACCOUNTING_ORG_BATCH_SIZE=100

# Clerk queda deshabilitado y fail-closed si estas variables están vacías.
# Obtener las claves de la aplicación exclusiva "Pymes v2"; nunca versionarlas.
PYMES_CLERK_PUBLISHABLE_KEY=
PYMES_CLERK_SECRET_KEY=
PYMES_CLERK_ISSUER=
PYMES_CLERK_AUDIENCE=pymes-v2-api
PYMES_CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:15173,http://localhost:15173
PYMES_CLERK_WEBHOOK_SECRET=
PYMES_CLERK_JWT_KEY=
PYMES_CLERK_API_URL=

# El worker IAM sólo se activa en Docker cuando PYMES_CLERK_SECRET_KEY existe.
PYMES_IAM_WORKER_BATCH_SIZE=1
PYMES_IAM_WORKER_POLL_INTERVAL=1s
PYMES_IAM_WORKER_LEASE_DURATION=2m
PYMES_IAM_WORKER_PUBLISH_TIMEOUT=90s
