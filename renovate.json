{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "America/Argentina/Buenos_Aires",
  "schedule": [
    "before 9am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "ignorePaths": [
    "v1/**",
    "LedgerSMB-master/**",
    "arca-facturacion/**",
    "pyafipws/**"
  ],
  "packageRules": [
    {
      "description": "Group platform updates for v2 consumers",
      "matchPackagePatterns": [
        "^@devpablocristo/",
        "^github.com/devpablocristo/platform/"
      ],
      "groupName": "devpablocristo platform",
      "groupSlug": "devpablocristo-platform",
      "automerge": false,
      "labels": [
        "dependencies",
        "platform"
      ]
    },
    {
      "description": "Hold majors for human review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  }
}
