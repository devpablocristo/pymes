FROM golang:1.26.5-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN GOWORK=off go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOWORK=off go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/pymes-v2-fiscal-homologation \
    ./cmd/fiscal-homologation

FROM alpine:3.22

RUN apk add --no-cache ca-certificates \
    && mkdir -p /var/lib/pymes/fiscal \
    && chown -R 65532:65532 /var/lib/pymes

COPY --from=build /out/pymes-v2-fiscal-homologation \
    /usr/local/bin/pymes-v2-fiscal-homologation

USER 65532:65532

ENTRYPOINT ["/usr/local/bin/pymes-v2-fiscal-homologation"]
