{
  "name": "@devpablocristo/pymes-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/generated.ts",
    "check:api": "node scripts/check-generated-api.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "preview": "vite preview",
    "audit": "npm audit --audit-level=high",
    "e2e": "node scripts/run-browser-e2e.mjs",
    "ci": "npm run check:api && npm run typecheck && npm run test && npm run build && npm run audit && npm run e2e"
  },
  "dependencies": {
    "@clerk/react": "6.12.10",
    "@devpablocristo/platform-browser": "0.1.0",
    "@devpablocristo/platform-calendar-board": "0.2.0",
    "@devpablocristo/platform-scheduling": "0.2.0",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/list": "6.1.21",
    "@fullcalendar/luxon3": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@tanstack/react-query": "5.101.4",
    "luxon": "3.7.2",
    "openapi-fetch": "0.17.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/luxon": "3.7.1",
    "@types/node": "25.0.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
